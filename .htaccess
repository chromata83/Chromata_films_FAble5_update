# ============================================================
# CHROMATA FILMS — canonicalisation + legacy URL recovery
#
# The previous (Squarespace) site lived at /blogchromatafilms/... and a set of
# extensionless top-level paths. Those URLs still hold the site's backlinks and
# are still in Google's index, so every one of them is 301'd to its equivalent
# on the current site rather than left to 404.
# ============================================================

# Never let Apache content-negotiate /gallery into gallery.html silently —
# we want an explicit 301 so there is only ever one canonical URL.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------- canonical scheme + host: always https://www ----------
  # Hostinger serves this site directly (no CDN/proxy in front), so %{HTTPS}
  # reliably reflects the real connection and this single rule is safe.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.chromatafilms.com/$1 [R=301,L]

  # ---------- /index.html -> / ----------
  RewriteRule ^index\.html$ / [R=301,L]

  # ---------- legacy blog posts -> case studies ----------
  RewriteRule ^blogchromatafilms/shashanadomantassaboniswedding/?$ /domantas-sabonis.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2025/9/17/jacqueline-and-gordon-wedding-a-st-tropez-experience-unlike-any-other/?$ /jacqueline-gordon.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2020/10/9/anna-andres-amp-david-wedding-french-riviera-escapade-at-hotel-du-cap-eden-roc/?$ /anna-andres.html [R=301,L,NC]

  # ---------- legacy blog posts -> journal articles ----------
  RewriteRule ^blogchromatafilms/2021/11/29/michal-amp-steve-wedding-a-st-tropez-love-story/?$ /journal-michal-steve.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2024/7/20/a-riviera-fairytale-alexa-and-wiltons-extravagant-st-tropez-wedding-by-house-of-kirschner/?$ /journal-alexa-wilton.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2022/10/15/jessica-amp-benjamin-stylish-jewish-wedding-at-hotel-beauvallon-near-st-tropez/?$ /journal-jessica-benjamin.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2024/2/21/sandra-amp-pedro-mixed-religion-ceremony-at-chateau-estoublon-provence/?$ /journal-sandra-pedro.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2023/11/4/a-four-seasons-buyout-wedding-for-the-most-amazing-celebrations/?$ /journal-four-seasons-buyout.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2023/9/28/daria-levin-crazy-circus-wedding-in-eze-french-riviera/?$ /journal-daria-levin.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2021/7/13/d-amp-a-wedding-in-lake-como-villa-bonomi/?$ /journal-d-a-villa-bonomi.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/mozzafiato-a-four-season-cap-ferrat-story-with-dolce-gabbana/?$ /journal-mozzafiato.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/sacksproductionsandalejandrapoupelweddingonlakecomo/?$ /journal-katya-joey.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/villablabianoluxurywedding/?$ /journal-jasmiina-tuukka.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/omygaude/?$ /journal-o-my-gaude.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/hannahlucasweddingvillaephrussi/?$ /journal-hannah-lucas.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/indianweddinglakecomo/?$ /journal-nida-sunny-highlight.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/lauren-and-jonathan-jewish-wedding-at-villa-rothschild-ephrussi/?$ /journal-lauren-jonathan.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2025/9/29/ai-wedding-masterclass-for-planners-and-designers/?$ /journal-ai-masterclass.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/(jewish|luxury)weddingmarrakech/?$ /journal-alexandra-raphael-marrakech.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2023/5/1/anastasia-amp-denis-intimate-wedding-on-the-french-riviera/?$ /journal-anastasia-denis.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2022/12/7/angela-amp-allister-modern-wedding-in-paris/?$ /journal-angela-allister-paris.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2023/5/10/angela-amp-allister-featured-in-brides/?$ /journal-angela-allister-brides.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2024/4/22/our-favorite-venues-in-south-of-france-to-celebrate-your-wedding/?$ /journal-france-venues.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2022/10/1/elisa-amp-thomas-a-chateau-wedding-on-the-french-riviera/?$ /journal-elisa-thomas.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2022/5/3/lauren-and-jonathan-wedding-dominican-republic-altos-de-chavon/?$ /journal-lauren-jonathan.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/aprincessweddinginpuglia/?$ /journal-puglia-princess.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2021/11/2/nida-amp-sunny-wedding-villa-erba-villa-bonomi-lake-como/?$ /journal-nida-sunny-teaser.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2023/1/19/artificial-intelligence-and-why-it-will-change-the-wedding-industry/?$ /journal-ai-wedding-industry.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2020/8/7/four-season-x-dolce-gabbana-teaser/?$ /journal-dolce-gabbana-teaser.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2022/2/4/giulietta-dreams-a-villa-cortine-story/?$ /journal-giulietta-villa-cortine.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2021/10/21/shashana-amp-domantas-sabonis-wedding-cap-ferrat/?$ /journal-sabonis-teaser.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2023/1/27/planning-your-destination-wedding-in-europe/?$ /journal-planning-europe.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2024/5/20/sumptuousevents-wedding-in-versailles-and-musee-rodin-paris/?$ /journal-parisian-dream.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2025/9/17/russell-westbrook-and-nina-westbrook-wedding-anniversary/?$ /journal-westbrook-anniversary.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2021/1/18/chromata-films-showreel-2021/?$ /gallery.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/2022/11/9/royal-wedding-at-vaux-le-vicomte-paris/?$ /vaux-le-vicomte.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/villa-la-vigie-wedding/?$ /journal-villa-la-vigie.html [R=301,L,NC]

  # ---------- consolidated duplicates -> merged page ----------
  RewriteRule ^journal-jacqueline-gordon\.html/?$ /jacqueline-gordon.html [R=301,L,NC]
  RewriteRule ^journal-anna-andres-eden-roc\.html/?$ /anna-andres.html [R=301,L,NC]
  RewriteRule ^journal-vaux-le-vicomte-royal\.html/?$ /vaux-le-vicomte.html [R=301,L,NC]

  # ---------- legacy blog posts with no direct equivalent ----------
  RewriteRule ^blogchromatafilms/2019/2/7/recongnition-as-a-visual-artist-oscars-nomination/?$ /the-studio.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/wedding-film-showreel-2018/?$ /gallery.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/clemence-lluc-elegant-wedding-in-the-heart-of-provence/?$ /real-weddings.html [R=301,L,NC]
  RewriteRule ^blogchromatafilms/villa-ephrussi-rothschild-wedding-film/?$ /real-weddings.html [R=301,L,NC]

  # ---------- everything else still under the old blog -> journal hub ----------
  # (tag archives, 2019-era posts, pagination offsets, ?format=amp variants)
  RewriteRule ^blogchromatafilms(/.*)?$ /journal.html [R=301,L,NC]

  # ---------- legacy top-level pages ----------
  RewriteRule ^about_chromata_films/?$ /the-studio.html [R=301,L,NC]
  RewriteRule ^contactus/?$ /contact.html [R=301,L,NC]
  RewriteRule ^gallery_chromatafilms/?$ /gallery.html [R=301,L,NC]
  RewriteRule ^pricing-1/?$ /contact.html [R=301,L,NC]
  RewriteRule ^styling/?$ /gallery.html [R=301,L,NC]
  RewriteRule ^wedding-showreel-2018/?$ /gallery.html [R=301,L,NC]
  RewriteRule ^blog_testimonials(/.*)?$ / [R=301,L,NC]
  RewriteRule ^(home|welcome|chromatafilms|francais)/?$ / [R=301,L,NC]
  RewriteRule ^a-french-wedding-in-gordes/?$ /journal.html [R=301,L,NC]
  RewriteRule ^black-and-white-wedding-on-the-french-riviera-cap-estel/?$ /journal.html [R=301,L,NC]
  RewriteRule ^prewedding-in-singapore-the-lion-city/?$ /journal.html [R=301,L,NC]
  RewriteRule ^luxury-jewish-wedding-in-provence/?$ /journal.html [R=301,L,NC]
  RewriteRule ^cote-magazine-corporate-event/?$ /journal.html [R=301,L,NC]
  RewriteRule ^style-me-pretty-publication/?$ /journal.html [R=301,L,NC]

  # ---------- extensionless -> .html ----------
  # Catches every other old pretty URL that happens to match a current page,
  # e.g. /the-studio -> /the-studio.html. Cannot loop: once redirected the
  # request resolves to a real file and the !-f condition stops matching.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [R=301,L]
</IfModule>
